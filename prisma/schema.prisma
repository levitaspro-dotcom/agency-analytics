generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  MANAGER
  CLIENT
}

enum TransactionType {
  REVENUE
  OZON_FEE
  COGS
  EXTERNAL_EXPENSE
  TAX
}

enum AiProvider {
  ANTHROPIC
  OPENAI
}

model User {
  id                String              @id @default(cuid())
  email             String              @unique
  passwordHash      String
  name              String
  role              UserRole
  /// Когда пользователь сам задал пароль по ссылке из письма-приглашения. Пусто — приглашение
  /// отправлено, но ещё не принято (пароль случайный, никому не известен и вход невозможен).
  inviteAcceptedAt  DateTime?
  createdAt         DateTime            @default(now())
  assignments       ProjectAssignment[]
  activity          ActivityLog[]
  aiMessages        AiMessage[]
  aiRecommendations AiRecommendation[]
  inviteTokens      InviteToken[]
}

/// Одноразовая ссылка-приглашение для первого входа: пользователь создаётся с заведомо
/// случайным паролем (никто его не знает), переходит по ссылке из письма и задаёт пароль сам.
model InviteToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Client {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  projects  Project[]
}

model Project {
  id                String                @id @default(cuid())
  clientId          String
  client            Client                @relation(fields: [clientId], references: [id])
  name              String
  /// Ставка налога в процентах от выручки (например 6 для УСН «Доходы» 6%). 0/не задано — налог не считается автоматически. Задаётся вручную, синхронизация её не трогает.
  taxRatePercent    Float                 @default(0)
  createdAt         DateTime              @default(now())
  stores            Store[]
  products          Product[]
  transactions      FinanceTransaction[]
  assignments       ProjectAssignment[]
  aiMessages        AiMessage[]
  aiRecommendations AiRecommendation[]
}

model Store {
  id                  String                @id @default(cuid())
  projectId           String
  project             Project               @relation(fields: [projectId], references: [id])
  name                String
  ozonShopId          String?
  ozonClientId        String?
  ozonApiKeyEncrypted String?
  ozonApiKeyLast4     String?
  lastTestAt          DateTime?
  lastTestOk          Boolean?
  lastTestMessage     String?
  lastSyncAt          DateTime?
  lastSyncOk          Boolean?
  lastSyncMessage     String?
  lastSyncCount       Int?
  createdAt           DateTime              @default(now())
  products            Product[]
  transactions        FinanceTransaction[]
}

model ProjectAssignment {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  allowedSections String[] @default([])
  createdAt       DateTime @default(now())

  @@unique([projectId, userId])
}

model Product {
  id           String                @id @default(cuid())
  projectId    String
  project      Project               @relation(fields: [projectId], references: [id])
  storeId      String?
  store        Store?                @relation(fields: [storeId], references: [id])
  name         String
  sku          String
  /// Артикул продавца (offer_id) — стабильный ключ сопоставления с каталогом Ozon при повторных синхронизациях, в отличие от числового sku, который иногда недоступен сразу.
  offerId      String?
  sellPrice    Float
  costPrice    Float
  createdAt    DateTime              @default(now())
  transactions FinanceTransaction[]
}

model FinanceTransaction {
  id          String           @id @default(cuid())
  projectId   String
  project     Project          @relation(fields: [projectId], references: [id])
  storeId     String?
  store       Store?           @relation(fields: [storeId], references: [id])
  productId   String?
  product     Product?         @relation(fields: [productId], references: [id])
  type        TransactionType
  category    String
  amount      Float
  date        DateTime
  description String?
  externalId  String?
  createdAt   DateTime         @default(now())

  @@index([projectId, date])
  @@unique([storeId, externalId])
}

model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName  String?
  action     String
  targetType String
  targetId   String?
  meta       Json?
  createdAt  DateTime @default(now())
}

/// Настройка серверного ИИ-адаптера (заменяемый, не привязан к конкретной модели).
/// Ключ хранится в зашифрованном виде и никогда не отдаётся обратно в интерфейс.
/// Одновременно активна только одна конфигурация — замена деактивирует предыдущую,
/// не удаляя её (история подключений сохраняется).
model AiProviderConfig {
  id              String     @id @default(cuid())
  provider        AiProvider
  model           String
  apiKeyEncrypted String
  apiKeyLast4     String
  active          Boolean    @default(true)
  lastTestAt      DateTime?
  lastTestOk      Boolean?
  lastTestMessage String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

/// История переписки с ИИ-аналитиком по проекту (доступ — как и к остальным данным проекта).
model AiMessage {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName  String?
  role      String
  content   String
  dataAsOf  DateTime?
  createdAt DateTime  @default(now())

  @@index([projectId, createdAt])
}

/// Проверяемая рекомендация ИИ-аналитика: структурированные поля + на каких именно
/// цифрах она основана (evidence) и на какой момент данные считались актуальными (dataAsOf),
/// чтобы было видно, не устарела ли рекомендация.
model AiRecommendation {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdByUserId String?
  createdByUser   User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByName   String?
  problem         String
  scope           String
  metrics         String
  action          String
  priority        String
  expectedEffect  String?
  assumptions     String
  evidence        String
  evidenceHref    String?
  dataAsOf        DateTime
  rawModelOutput  String?
  createdAt       DateTime @default(now())

  @@index([projectId, createdAt])
}
