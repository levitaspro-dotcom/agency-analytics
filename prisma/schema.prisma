generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  MANAGER
  CLIENT
}

enum TransactionType {
  REVENUE
  OZON_FEE
  COGS
  EXTERNAL_EXPENSE
  TAX
}

enum AiProvider {
  ANTHROPIC
  OPENAI
}

/// Площадка, на которой торгует магазин. Сейчас реально подключается только Ozon
/// (см. поля ozon* в Store) — Wildberries пока просто отмечается как площадка на будущее,
/// без реальной интеграции.
enum Marketplace {
  OZON
  WILDBERRIES
}

model User {
  id                String              @id @default(cuid())
  email             String              @unique
  passwordHash      String
  name              String
  role              UserRole
  /// Продавец (Client), к которому привязан этот логин — заполняется для роли CLIENT: это его
  /// доступ, выданный конкретному продавцу. У менеджеров и главных администраторов не задаётся.
  /// Удаление продавца удаляет вместе с ним и все привязанные к нему логины (доступы).
  clientId          String?
  client            Client?             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// Когда пользователь сам задал пароль по ссылке из письма-приглашения. Пусто — приглашение
  /// отправлено, но ещё не принято (пароль случайный, никому не известен и вход невозможен).
  inviteAcceptedAt  DateTime?
  createdAt         DateTime            @default(now())
  assignments       ProjectAssignment[]
  activity          ActivityLog[]
  aiMessages        AiMessage[]
  aiRecommendations AiRecommendation[]
  inviteTokens      InviteToken[]

  @@index([clientId])
}

/// Одноразовая ссылка-приглашение для первого входа: пользователь создаётся с заведомо
/// случайным паролем (никто его не знает), переходит по ссылке из письма и задаёт пароль сам.
model InviteToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Client {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  projects  Project[]
  users     User[]
}

model Project {
  id                String                @id @default(cuid())
  clientId          String
  client            Client                @relation(fields: [clientId], references: [id])
  name              String
  /// Площадка магазина (Ozon сейчас, Wildberries — на будущее). Не влияет на синхронизацию,
  /// только отображается как метка — реальное подключение к Wildberries появится позже.
  marketplace       Marketplace           @default(OZON)
  /// Ставка налога в процентах от выручки (например 6 для УСН «Доходы» 6%). 0/не задано — налог не считается автоматически. Задаётся вручную, синхронизация её не трогает.
  taxRatePercent    Float                 @default(0)
  createdAt         DateTime              @default(now())
  stores            Store[]
  products          Product[]
  transactions      FinanceTransaction[]
  assignments       ProjectAssignment[]
  aiMessages        AiMessage[]
  aiRecommendations AiRecommendation[]
}

model Store {
  id                  String                @id @default(cuid())
  projectId           String
  project             Project               @relation(fields: [projectId], references: [id])
  name                String
  ozonShopId          String?
  ozonClientId        String?
  ozonApiKeyEncrypted String?
  ozonApiKeyLast4     String?
  lastTestAt          DateTime?
  lastTestOk          Boolean?
  lastTestMessage     String?
  lastSyncAt          DateTime?
  lastSyncOk          Boolean?
  lastSyncMessage     String?
  lastSyncCount       Int?
  /// Отдельная пара ключей рекламного кабинета Ozon (Performance API) — НЕ те же Client-Id/Api-Key,
  /// что для основного Seller API выше (ozonClientId/ozonApiKeyEncrypted): другой личный кабинет
  /// Ozon (Продвижение → Настройки Performance API), другой способ авторизации (OAuth2
  /// client_credentials, см. lib/integrations/ozonPerformance.ts). Пока используется только для
  /// проверки подключения — сама статистика показов/кликов/CTR ещё не подтягивается.
  ozonPerfClientId              String?
  ozonPerfClientSecretEncrypted String?
  ozonPerfClientSecretLast4     String?
  lastPerfTestAt                DateTime?
  lastPerfTestOk                Boolean?
  lastPerfTestMessage           String?
  createdAt           DateTime              @default(now())
  products            Product[]
  transactions        FinanceTransaction[]
}

model ProjectAssignment {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  allowedSections String[] @default([])
  createdAt       DateTime @default(now())

  @@unique([projectId, userId])
}

model Product {
  id           String                @id @default(cuid())
  projectId    String
  project      Project               @relation(fields: [projectId], references: [id])
  storeId      String?
  store        Store?                @relation(fields: [storeId], references: [id])
  name         String
  sku          String
  /// Артикул продавца (offer_id) — стабильный ключ сопоставления с каталогом Ozon при повторных синхронизациях, в отличие от числового sku, который иногда недоступен сразу.
  offerId      String?
  /// Штрихкод (ШК) — приходит из отчёта «Позаказный отчёт о реализации» (/v1/finance/realization/posting,
  /// item.barcode), который Ozon публикует только за уже ЗАКРЫТЫЕ календарные месяцы (обычно не раньше
  /// 5 числа следующего месяца). null, пока по этому товару не было ни одной синхронизации, попавшей на
  /// уже закрытый месяц — это не ошибка, а нормальное состояние для текущего/недавнего периода.
  barcode      String?
  sellPrice    Float
  costPrice    Float
  /// Товар есть в каталоге Ozon этого магазина по последней успешной синхронизации. При смене
  /// Client-Id/Api-Key на другой Ozon-аккаунт (или если товар просто сняли с продажи) старые
  /// записи не удаляются — на них могут ссылаться уже посчитанные финансовые операции — а
  /// перестают быть активными и скрываются из списка «Товары», чтобы в нём не накапливались
  /// позиции, которых в этом магазине на самом деле больше нет.
  active       Boolean               @default(true)
  createdAt    DateTime              @default(now())
  transactions FinanceTransaction[]
  realizationMonths ProductRealizationMonth[]

  @@index([projectId, storeId, active])
}

/// Данные из «Позаказного отчёта о реализации» Ozon (/v1/finance/realization/posting) — один ряд на
/// товар за КАЛЕНДАРНЫЙ месяц (Ozon отдаёт этот отчёт только помесячно, и только за уже закрытый
/// месяц — обычно публикует не раньше 5 числа следующего). В отличие от FinanceTransaction (который
/// собирается из /v1/finance/accrual/postings за произвольный период), эти данные физически не
/// существуют у Ozon за текущий незакрытый месяц — поэтому за свежие периоды строк здесь не будет,
/// это нормально, а не потерянные данные.
///
/// Хранится ОТДЕЛЬНО от FinanceTransaction (а не как ещё один OZON_FEE), чтобы не задваивать уже
/// учтённую через accrual/postings комиссию/логистику — из этого отчёта в приложение попадают
/// только показатели, которых больше НЕОТКУДА взять: доставлено/возвращено штук и суммы по баллам
/// покупателя и партнёрским программам банков.
model ProductRealizationMonth {
  id        String   @id @default(cuid())
  projectId String
  storeId   String
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  year      Int
  month     Int
  /// Кол-во единиц товара, реально ДОСТАВЛЕННЫХ покупателю за этот календарный месяц (delivery_commission.quantity).
  deliveredQty Int   @default(0)
  /// Кол-во единиц товара, ВОЗВРАЩЁННЫХ за этот календарный месяц (return_commission.quantity).
  returnedQty  Int   @default(0)
  /// Сумма скидки, покрытой баллами покупателя Ozon (delivery_commission.bonus) — раньше эта категория
  /// была в принципе недоступна ни через один метод API (см. историю lib/finance.ts), появилась только
  /// с этим отчётом.
  bonusAmount            Float @default(0)
  /// Сумма по программам продвижения «Звёздные товары» (delivery_commission.stars).
  starsAmount            Float @default(0)
  /// Сумма по программам софинансирования банков-партнёров (delivery_commission.bank_coinvestment).
  bankCoinvestmentAmount Float @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, storeId, year, month])
  @@index([projectId, year, month])
}

model FinanceTransaction {
  id          String           @id @default(cuid())
  projectId   String
  project     Project          @relation(fields: [projectId], references: [id])
  storeId     String?
  store       Store?           @relation(fields: [storeId], references: [id])
  productId   String?
  product     Product?         @relation(fields: [productId], references: [id])
  type        TransactionType
  category    String
  amount      Float
  /// Количество единиц товара в этой операции — заполняется только у REVENUE-строк,
  /// пришедших из состава заказа (posting.products[]), чтобы на странице «Товары»
  /// можно было показать «продано штук» за период. У расходных строк Ozon (OZON_FEE)
  /// своё количество тоже иногда есть в начислении, но для суммарного «продано» по
  /// товару используем именно строки выручки — они не дублируются на возврат/логистику.
  quantity    Int?
  /// Дата ОФОРМЛЕНИЯ заказа (у REVENUE/COGS) или дата начисления (у OZON_FEE — там другой
  /// даты и нет). Период на страницах приложения фильтруется по этому полю по умолчанию.
  date        DateTime
  /// Дата НАЧИСЛЕНИЯ Ozon по этому отправлению (op.operation_date из /v1/finance/accrual/postings) —
  /// обычно на несколько дней позже даты заказа. У OZON_FEE совпадает с date (другой даты там
  /// нет). У REVENUE/COGS может отсутствовать (null), если по этому отправлению за период ещё
  /// не пришло ни одной строки начисления — дозаполняется на следующей синхронизации. Нужна,
  /// чтобы период можно было считать «по факту Ozon», как в официальных отчётах площадки,
  /// а не только по дате заказа.
  accrualDate DateTime?
  description String?
  externalId  String?
  createdAt   DateTime         @default(now())

  @@index([projectId, date])
  @@index([projectId, accrualDate])
  @@unique([storeId, externalId])
}

model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName  String?
  action     String
  targetType String
  targetId   String?
  meta       Json?
  createdAt  DateTime @default(now())
}

/// Настройка серверного ИИ-адаптера (заменяемый, не привязан к конкретной модели).
/// Ключ хранится в зашифрованном виде и никогда не отдаётся обратно в интерфейс.
/// Одновременно активна только одна конфигурация — замена деактивирует предыдущую,
/// не удаляя её (история подключений сохраняется).
model AiProviderConfig {
  id              String     @id @default(cuid())
  provider        AiProvider
  model           String
  apiKeyEncrypted String
  apiKeyLast4     String
  active          Boolean    @default(true)
  lastTestAt      DateTime?
  lastTestOk      Boolean?
  lastTestMessage String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

/// История переписки с ИИ-аналитиком по проекту (доступ — как и к остальным данным проекта).
model AiMessage {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName  String?
  role      String
  content   String
  dataAsOf  DateTime?
  createdAt DateTime  @default(now())

  @@index([projectId, createdAt])
}

/// Проверяемая рекомендация ИИ-аналитика: структурированные поля + на каких именно
/// цифрах она основана (evidence) и на какой момент данные считались актуальными (dataAsOf),
/// чтобы было видно, не устарела ли рекомендация.
model AiRecommendation {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdByUserId String?
  createdByUser   User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByName   String?
  problem         String
  scope           String
  metrics         String
  action          String
  priority        String
  expectedEffect  String?
  assumptions     String
  evidence        String
  evidenceHref    String?
  dataAsOf        DateTime
  rawModelOutput  String?
  createdAt       DateTime @default(now())

  @@index([projectId, createdAt])
}
